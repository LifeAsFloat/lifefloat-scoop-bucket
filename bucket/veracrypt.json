{
    "version": "1.26.31",
    "description": "A free open source disk encryption software for Windows, Mac OSX and Linux based on TrueCrypt.",
    "homepage": "https://veracrypt.fr",
    "license": "Apache-2.0",
    "url": "https://github.com/veracrypt/VeraCrypt/releases/download/VeraCrypt_1.26.31/VeraCrypt.Portable.1.26.31.exe#/setup.exe",
    "hash": "sha256:05712C10D0E27B88A2E16AE62B807A77AFD2D11C48847FCCB2E51D004BD4252B",
    "installer": {
        "script": [
            "Start-Process -Wait \"$dir\\setup.exe\"",
            "Remove-Item -Recurse \"$dir\\setup.exe\"",
            "Move-Item \"$dir\\VeraCrypt\\*\" -Destination \"$dir\"",
            "Remove-Item -Recurse \"$dir\\VeraCrypt\""
        ]
    },
    "persist": "Configuration.xml",
    "pre_install": "If (!(Test-Path \"$persist_dir\\Configuration.xml\")) { New-Item \"$dir\\Configuration.xml\" -ItemType File | Out-Null }",
    "checkver": {
        "url": "https://veracrypt.io/en/Downloads.html",
        "regex": "Windows, macOS and Linux: ([\\d.]+)"
    },
    "autoupdate": {
        "url": "https://github.com/veracrypt/VeraCrypt/releases/download/VeraCrypt_$version/VeraCrypt.Portable.$version.exe#/setup.exe",
        "hash": {
            "url": "https://github.com/veracrypt/VeraCrypt/releases/download/VeraCrypt_$version/veracrypt-$version-sha256sum.txt",
            "regex": "$sha256\\s+VeraCrypt Portable $version\\.exe"
        }
    }
}
