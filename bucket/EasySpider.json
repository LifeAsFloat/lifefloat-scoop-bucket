{
    "version": "0.6.5",
    "description": "A powerful, simple and easy-to-use web crawling framework based on Python3.",
    "homepage": "https://www.easyspider.cn",
    "license": "AGPL-3.0 license",
    "architecture": {
        "64bit": {
            "url": "https://github.com/NaiboWang/EasySpider/releases/download/v0.6.5/EasySpider_0.6.5_Windows_x64.7z",
            "hash": "5b60c019d53ddc442b2f1eba1fa2c7ffb13be41f0556501407927eae87013fa4",
            "extract_dir": "EasySpider_Windows_x64"
        }
    },
    "persist": [
        "Data",
        "execution_instances",
        "tasks",
        "config.json"
    ],
    "post_install": [
        "$datapath = Join-Path $env:AppData 'EasySpider'",
        ". \"$bucketsdir\\lifefloat-scoop-bucket\\scripts\\Functions.ps1\"",
        "Move-Data_dir -data_dir $datapath -persist_dir \"$persist_dir\\cache\""
    ],
    "pre_uninstall": "Remove-Item -Path (Join-Path $env:AppData 'EasySpider') -Recurse -Force -ErrorAction SilentlyContinue",
    "bin": "EasySpider.exe",
    "shortcuts": [
        [
            "EasySpider.exe",
            "EasySpider"
        ]
    ],
    "checkver": {
        "url": "https://github.com/NaiboWang/EasySpider/releases/",
        "regex": "tag/v?([\\d.]+)\""
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/NaiboWang/EasySpider/releases/download/v$version/EasySpider_$version_Windows_x64.7z",
                "hash": {
                    "mode": "download"
                },
                "extract_dir": "EasySpider_Windows_x64"
            }
        }
    }
}
