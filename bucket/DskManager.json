    "post_install": [
        "if (!(Test-Path \"$persist_dir\\Db\")) { New-Item -ItemType Directory -Path \"$persist_dir\\Db\" | Out-Null }",
        "if (!(Test-Path \"$persist_dir\\config.ini\")) { Set-Content -Path \"$persist_dir\\config.ini\" '' -Encoding Ascii | Out-Null }",
        "Set-Content \"$dir\\config.ini\" \"[General]`nconfig=$($persist_dir.Replace('\\','/'))/config.ini\" -Encoding ASCII"
    ],
    "pre_uninstall": [
        "Stop-Process -Name fsmainx64 -ErrorAction SilentlyContinue",
        "Stop-Process -Name fsdockhostx64 -ErrorAction SilentlyContinue"
    ],
    "persist": "Db",
    "bin": "fsmainx64.exe",
    "shortcuts": [["fsmainx64.exe", "Dskmanager"]],
    "checkver": {
        "url": "https://api-update.dskmanager.com/verinfo/windows?lang=chs&ver=1.0&arch=x64",
        "regex": "\"ver\":\"([\\d.]+)\""
    },
