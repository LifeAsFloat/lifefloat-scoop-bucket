{
    "version": "1.14.9",
    "description": "A markdown editor downloaded by mirror",
    "homepage": "https://typoraio.cn",
    "license": {
        "identifier": "Proprietary",
        "url": "https://support.typora.io/License-Agreement/"
    },
    "suggest": {
        "pandoc": "pandoc",
        "See-Yue-Typora": "lifefloat-scoop-bucket/See-Yue-Typora"
    },
    "notes": [
        "Download from typoraio.cn mirror site.",
        "The configuration files and user data are stored in persistent directory.",
        "run 'scoop install lifefloat-scoop-bucket/See-Yue-Typora' to install See Yue theme for Typora.",
        "If you want to remove the configuration files and user data when uninstalling, run 'scoop uninstall typora-cn -p'."
    ],
    "architecture": {
        "64bit": {
            "url": "https://downloads.typoraio.cn/windows/typora-setup-x64-1.14.9.exe",
            "hash": "232233247bbd739fad7707075cb0dd2a47448dba1e2dec15fca3b0d501952f7d"
        },
        "32bit": {
            "url": "https://downloads.typoraio.cn/windows/typora-setup-ia32-1.14.9.exe",
            "hash": "5ffcf5ca6efb25481b443d3833921e77626cc90743c529afa64315050bb35a34"
        },
        "arm64": {
            "url": "https://downloads.typoraio.cn/windows/typora-setup-arm64-1.14.9.exe",
            "hash": "ef72ba3c23430259587600d5eb711a0df7e4db788a22be7b7c7e97a9f4afd2f7"
        }
    },
    "innosetup": true,
    "post_install": [
        ". \"$bucketsdir\\lifefloat-scoop-bucket\\scripts\\Functions.ps1\"",
        "$configpath = Join-Path $env:AppData 'Typora'",
        "Move-Data_dir -data_dir $configpath -persist_dir $persist_dir"
    ],
    "pre_uninstall": [
        "if ($purge) {",
        "    Remove-Item -Recurse -Force \"$env:AppData\\Typora\"",
        "}"
    ],
    "bin": [
        [
            "Typora.exe",
            "Typora-scoop"
        ]
    ],
    "shortcuts": [
        [
            "Typora.exe",
            "Typora-scoop"
        ]
    ],
    "checkver": {
        "url": "https://typoraio.cn/releases/stable",
        "regex": "typora-setup-(?:x64|ia32|arm64)-([\\d.]+)\\.exe"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://downloads.typoraio.cn/windows/typora-setup-x64-$version.exe"
            },
            "32bit": {
                "url": "https://downloads.typoraio.cn/windows/typora-setup-ia32-$version.exe"
            },
            "arm64": {
                "url": "https://downloads.typoraio.cn/windows/typora-setup-arm64-$version.exe"
            }
        }
    }
}
